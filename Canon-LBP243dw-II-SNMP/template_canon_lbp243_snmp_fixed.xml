  <triggers>
    <trigger>
      <uuid>26f5064626214d8e852af09e520a562f</uuid>
      <expression>nodata(/Template Canon LBP242 II 243 II SNMP/printer.uptime,5m)=1</expression>
      <name>Printer SNMP monitoring unavailable</name>
      <priority>HIGH</priority>
      <description>No SNMP response from the printer for 5 minutes.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>9be7046d3d544f778a14fa35ccaf18e0</uuid>
      <expression>last(/Template Canon LBP242 II 243 II SNMP/net.if.status[1])&lt;&gt;1</expression>
      <name>Printer Ethernet link is down</name>
      <priority>HIGH</priority>
      <description>FastEthernet interface index 1 is not operational.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>1ce6cb7361a14c96a1c012123168de2b</uuid>
      <expression>last(/Template Canon LBP242 II 243 II SNMP/printer.toner.black.level)&lt;20 and last(/Template Canon LBP242 II 243 II SNMP/printer.toner.black.level)&gt;=10</expression>
      <name>Printer black toner below 20%</name>
      <priority>WARNING</priority>
      <description>Black toner level is between 10% and 20%.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>72bc455d93434fb88d3291e629f8c47a</uuid>
      <expression>last(/Template Canon LBP242 II 243 II SNMP/printer.toner.black.level)&lt;10</expression>
      <name>Printer black toner critically low</name>
      <priority>HIGH</priority>
      <description>Black toner level is below 10%.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>02bf670c15b34f8aa5f7a0d0ce8a3415</uuid>
      <expression>change(/Template Canon LBP242 II 243 II SNMP/printer.pages.lifetime)&lt;0</expression>
      <name>Printer lifetime counter decreased</name>
      <priority>WARNING</priority>
      <description>Lifetime counter decreased; investigate printer replacement, reset, or counter anomaly.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>2dac54e6e4ca4b3d96ca26ea0efad21f</uuid>
      <expression>change(/Template Canon LBP242 II 243 II SNMP/printer.uptime)&lt;0</expression>
      <name>Printer reboot detected</name>
      <priority>INFO</priority>
      <description>SNMP sysUpTime decreased, indicating a reboot or SNMP agent restart.</description>
      <manual_close>YES</manual_close>
    </trigger>
  </triggers>
