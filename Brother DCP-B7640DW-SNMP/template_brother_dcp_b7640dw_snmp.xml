        <item>
          <uuid>b5ed12e95a1f4a4fb90a6c7d0ad488d7</uuid>
          <name>Printer Error State</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.2.1.25.3.5.1.2.1</snmp_oid>
          <key>printer.error.state</key>
          <delay>1m</delay>
          <history>7d</history>
          <trends>0</trends>
          <value_type>CHAR</value_type>
          <description>hrPrinterDetectedErrorState decoded to text flags (empty = no error).</description>
          <preprocessing>
            <step>
              <type>JAVASCRIPT</type>
              <parameters>
                <parameter>var h = value.replace(/[^0-9a-fA-F]/g, '');
if (h.length &lt; 2) { return ''; }
var b1 = parseInt(h.substr(0, 2), 16);
var b2 = (h.length &gt;= 4) ? parseInt(h.substr(2, 2), 16) : 0;
var f = [];
if (b1 &amp; 0x80) f.push('lowPaper');
if (b1 &amp; 0x40) f.push('noPaper');
if (b1 &amp; 0x20) f.push('lowToner');
if (b1 &amp; 0x10) f.push('noToner');
if (b1 &amp; 0x08) f.push('doorOpen');
if (b1 &amp; 0x04) f.push('jammed');
if (b1 &amp; 0x02) f.push('offline');
if (b1 &amp; 0x01) f.push('serviceRequested');
if (b2 &amp; 0x80) f.push('inputTrayMissing');
if (b2 &amp; 0x40) f.push('outputTrayMissing');
if (b2 &amp; 0x20) f.push('markerSupplyMissing');
if (b2 &amp; 0x10) f.push('outputNearFull');
if (b2 &amp; 0x08) f.push('outputFull');
if (b2 &amp; 0x04) f.push('inputTrayEmpty');
if (b2 &amp; 0x02) f.push('overduePreventMaintenance');
return f.join(', ');</parameter>
              </parameters>
            </step>
          </preprocessing>
        </item>
