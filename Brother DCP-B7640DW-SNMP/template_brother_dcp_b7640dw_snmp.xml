  <triggers>
    <trigger>
      <uuid>014cabced6c345a9adc8c4d8b7f8634f</uuid>
      <expression>nodata(/Template Brother DCP-B7640DW SNMP/printer.uptime,5m)=1</expression>
      <name>Brother DCP-B7640DW SNMP unavailable</name>
      <priority>HIGH</priority>
      <description>No SNMP response for 5 minutes.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>2d12e3e6e17e44cb9c563fc1d11be2bf</uuid>
      <expression>max(/Template Brother DCP-B7640DW SNMP/icmpping,#3)=0</expression>
      <name>Brother DCP-B7640DW not reachable by ping</name>
      <priority>HIGH</priority>
      <description>Last 3 ping checks failed.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>aca998382e624c569092b7ed5bff3a6b</uuid>
      <expression>last(/Template Brother DCP-B7640DW SNMP/printer.cover.status)=3 or last(/Template Brother DCP-B7640DW SNMP/printer.cover.status)=5</expression>
      <name>Brother DCP-B7640DW cover is open</name>
      <priority>HIGH</priority>
      <description>Printer cover/interlock is open.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>317712d1ffb84bf19bba03edf989e7e6</uuid>
      <expression>length(last(/Template Brother DCP-B7640DW SNMP/printer.error.state))&gt;0</expression>
      <name>Brother DCP-B7640DW reports: {{ITEM.LASTVALUE1}}</name>
      <priority>WARNING</priority>
      <description>Printer reports one or more error/alert flags.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>6f0617412dd64c3db5934de7a1374210</uuid>
      <expression>last(/Template Brother DCP-B7640DW SNMP/printer.toner.black.level)=0</expression>
      <name>Brother DCP-B7640DW black toner empty</name>
      <priority>HIGH</priority>
      <description>Toner level reported as 0 (empty).</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>fec805461a014661b7f81784a8973e37</uuid>
      <expression>last(/Template Brother DCP-B7640DW SNMP/printer.drum.percent)&lt;10 and last(/Template Brother DCP-B7640DW SNMP/printer.drum.percent)&gt;=5</expression>
      <name>Brother DCP-B7640DW drum unit below 10%</name>
      <priority>WARNING</priority>
      <description>Drum unit remaining life is between 5% and 10%.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>f89bf1721e53475eb7e5650e2d975ddb</uuid>
      <expression>last(/Template Brother DCP-B7640DW SNMP/printer.drum.percent)&lt;5</expression>
      <name>Brother DCP-B7640DW drum unit critically low</name>
      <priority>HIGH</priority>
      <description>Drum unit remaining life is below 5%.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>b1a4230342b746fe95b011fa4b322abb</uuid>
      <expression>change(/Template Brother DCP-B7640DW SNMP/printer.pages.lifetime)&lt;0</expression>
      <name>Brother DCP-B7640DW lifetime counter decreased</name>
      <priority>WARNING</priority>
      <description>Lifetime counter decreased; check for replacement, reset or counter anomaly.</description>
      <manual_close>YES</manual_close>
    </trigger>
    <trigger>
      <uuid>bc4e39069cfe4885ab57863aaa65edf6</uuid>
      <expression>change(/Template Brother DCP-B7640DW SNMP/printer.uptime)&lt;0</expression>
      <name>Brother DCP-B7640DW reboot detected</name>
      <priority>INFO</priority>
      <description>sysUpTime decreased: reboot or SNMP agent restart.</description>
      <manual_close>YES</manual_close>
    </trigger>
  </triggers>
